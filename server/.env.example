# Server Environment Configuration
# Copy this to .env and fill in your values

# Node Environment
NODE_ENV=development

# Server Port
PORT=5001

# MongoDB Connection String
# For local development:
# MONGODB_URI=mongodb://localhost:27017/skillswap-plus
# For MongoDB Atlas:
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/skillswap-plus

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# CORS - Frontend URL
CLIENT_URL=http://localhost:3000

# Payment (Mock Mode for Testing)
PAYMENT_MODE=test
PAYMENT_API_KEY=test_key

# Email (Optional - for production)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Admin defaults (change immediately after first setup!)
ADMIN_EMAIL=admin@skillswap.edu
ADMIN_PASSWORD=Admin@123
